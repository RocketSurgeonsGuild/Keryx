<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <!--
        A project that references Rocket.Surgery.AssemblyInfo gets its generated AssemblyInfo class in its own root namespace (set here, after
        the SDK has defaulted RootNamespace). In the global namespace every such project would have the same AssemblyInfo, and a project that
        sees another's internals would bind typeof(AssemblyInfo) to the wrong copy.
    -->
    <PropertyGroup>
        <AssemblyInfoNamespace Condition="'$(AssemblyInfoNamespace)' == ''">$(RootNamespace)</AssemblyInfoNamespace>
    </PropertyGroup>
    <!--
        On CI, skip Verify's sponsor check: the Verify_SponsorshipExemption in Directory.Build.props already settles it, and the check
        calls MSBuild on every project reference of each test project, which serializes test builds behind unrelated compiles.
        ContinuousIntegrationBuild is only known after Directory.Build.props, so this has to be in a .targets file.
    -->
    <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
        <_SponsorCheck_OwnerVerified_Verify_eea2745e>true</_SponsorCheck_OwnerVerified_Verify_eea2745e>
    </PropertyGroup>
</Project>
