<Project>
    <!--
        Before the parent import: Rocket.Surgery.SDK only wires up the test extensions when IsTestProject is already true. Only the *.Tests
        projects are test projects; the benchmarks are a plain executable (a test project would fail `dotnet test` for finding no tests).
    -->
    <PropertyGroup>
        <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <!-- Nothing under test/ ships. -->
        <IsPackable>false</IsPackable>
        <!-- The build pipeline passes its own coverage settings; the option takes one value. -->
        <RsgSdk_Testing_CoverageSettings>false</RsgSdk_Testing_CoverageSettings>
    </PropertyGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <!--
            The repo-wide LatestMajor would run the net10.0 tests on the newest installed runtime, which changes the generated
            compilations' diagnostics. Keep each target on its own major: mise installs the net10.0 runtime beside the SDK for this.
        -->
        <RollForward>Minor</RollForward>
    </PropertyGroup>
</Project>
