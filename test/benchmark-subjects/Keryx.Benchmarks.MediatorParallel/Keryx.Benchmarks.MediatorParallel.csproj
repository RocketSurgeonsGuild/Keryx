<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Mediator (martinothamar) 3.0.2 with its TaskWhenAllPublisher, for the real-world parallel publish scenario only (owner decision 30d).
        Mediator's notification publisher is a generator option, so it is fixed per assembly: the parallel publisher needs a project of its
        own. Singleton lifetime, Mediator's default; its generated Mediator class is public, in this project's namespace.
    -->
    <ItemGroup>
        <PackageReference Include="Mediator.Abstractions" />
        <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
