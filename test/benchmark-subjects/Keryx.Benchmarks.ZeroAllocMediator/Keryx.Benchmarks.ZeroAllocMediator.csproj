<Project Sdk="Microsoft.NET.Sdk">
    <!--
        ZeroAlloc.Mediator 7.0.1 and its generator. The generated static Mediator class, IMediator and AddMediator() are internal to this
        assembly, so the benchmark runner sees them through InternalsVisibleTo.
    -->
    <PropertyGroup>
        <!-- CA1068 (CancellationToken last): ZeroAlloc.Mediator's behavior shape takes the token before next, and its generator requires it. -->
        <!--
            ZAM003 (request is a class, use a readonly record struct): every subject sends the same sealed record class requests, so the
            libraries are compared on one request shape.
        -->
        <NoWarn>$(NoWarn);CA1068;ZAM003</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Keryx.Benchmarks" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ZeroAlloc.Mediator" />
        <PackageReference Include="ZeroAlloc.Mediator.Generator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
