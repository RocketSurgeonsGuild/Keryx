<Project>
    <!--
        Keryx needs C# 11 or later in every project that references it: the attributes' init-only properties (C# 9) are set by generated
        code and by [BehaviorOrder(..., Order = n)], and [RunsAfter<T>]/[RunsBefore<T>] are generic attributes (C# 11). A netstandard2.0
        project defaults to C# 7.3, so, imported before the project file, this raises only that default, as Specular.Scanning.Sources does
        for its own generator projects. A LangVersion the project (or its Directory.Build.props) sets itself still wins: it is never
        raised behind the project's back, because that would change the language the project's own code is compiled with. One below
        C# 11 is error KRX022 instead of compiler errors in generated code.
    -->
    <PropertyGroup>
        <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    </PropertyGroup>
    <!--
        MSBuild properties the host generator reads as build_property.*: RootNamespace for the namespace of the generated mediator and
        AddKeryx(), TargetFrameworkIdentifier and TargetFrameworkVersion for KRX031 (a host targets net10.0 or newer). Added just before the
        generated .editorconfig is written, when every other CompilerVisibleProperty is known: the .NET SDK's analyzers already ask for the
        target framework ones, and a property listed twice is written to the file twice.
    -->
    <Target Name="_KeryxAddCompilerVisibleProperties" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
        <ItemGroup>
            <CompilerVisibleProperty Include="RootNamespace;TargetFrameworkIdentifier;TargetFrameworkVersion" Exclude="@(CompilerVisibleProperty)" />
        </ItemGroup>
    </Target>
</Project>
