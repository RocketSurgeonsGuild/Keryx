<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Ships inside the Keryx package (src/Keryx packs this assembly into analyzers/dotnet/cs), never on its own. -->
        <IsPackable>false</IsPackable>
        <!-- The Specular.Scanning pack helper would only act on this project's own package; src/Keryx packs the cache wiring. -->
        <SpecularScanningPack>false</SpecularScanningPack>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <!--
            RS1038: this assembly holds the generators and analyzers and also the code fixes, so it references
            Microsoft.CodeAnalysis.CSharp.Workspaces. That is the maintainer's decision (2026-11-26, docs/adr/open-questions.md): one
            analyzer assembly instead of a separate Keryx.Analyzers.CodeFixes.
            The risk RS1038 guards against: the command-line compiler (csc, and dotnet build) does not ship Workspaces. It loads this
            assembly and runs the generators and analyzers, and only the IDE ever instantiates a CodeFixProvider. So code-fix types (the
            CodeFixes folder) must never be touched from a generator or analyzer code path: no shared static state, no base types, no
            signatures that mention a Workspaces type. Doing so fails with a FileNotFoundException for Microsoft.CodeAnalysis.Workspaces
            on the command line only. Code fixes may use generator and analyzer types, never the other way round.
        -->
        <NoWarn>$(NoWarn);RS1038</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <!-- Code fixes only (CodeFixes folder); never loaded by the command-line compiler. See the RS1038 note above. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
        <PackageReference Include="Specular.Scanning.Sources" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <PackageReference Include="System.Collections.Immutable" PrivateAssets="all" />
        <PackageReference Include="System.Text.Json" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Keryx.Tests" />
    </ItemGroup>

    <!--
        What src/Keryx packs from this project: the one analyzer assembly (generators, analyzers and code fixes), the System.Text.Json it
        loads beside it, and the scan cache wiring.
    -->
    <Target Name="GetKeryxPackageFiles" Returns="@(_KeryxPackageFile)">
        <ItemGroup>
            <_KeryxPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
            <_KeryxPackageFile Include="$(PkgSystem_Text_Json)/lib/netstandard2.0/System.Text.Json.dll" PackagePath="analyzers/dotnet/cs" />
            <_KeryxPackageFile Include="$(PkgSpecular_Scanning_Sources)/build/Specular.Scanning.Cache.targets" PackagePath="build" />
        </ItemGroup>
    </Target>
</Project>
